# MIRROR configuration. Copy to .env and fill in. Never commit .env.

# AssemblyAI Voice Agent API key. Server-side only: the browser never sees it.
# Without it, voice is disabled and typed commands drive the same runtime.
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_AGENT_URL=wss://agents.assemblyai.com/v1/ws
ASSEMBLYAI_VOICE=anna

# HMAC key for commit tokens. Use a long random value; tokens die if it changes.
#   python -c "import secrets; print(secrets.token_hex(32))"
MIRROR_COMMIT_SECRET=

# Where the runtime database (mirror.db) and the mock ERP (erp.db) live.
MIRROR_DATA_DIR=./data

# Demo controls: reset, deterministic fault injection, external world changes.
DEMO_MODE=true
DEMO_FAULT_INJECTION=true
# If set (and sandboxes are off), demo endpoints require the header X-Demo-Token with this value.
DEMO_ADMIN_TOKEN=

# Public demos: every browser session gets its own copy of the ERP world, so one visitor's
# commits, faults and resets never touch another visitor's. Demo controls then act only on the
# caller's sandbox and need no admin token. Sandboxes are deleted after 24 hours.
MIRROR_SANDBOX_PER_SESSION=false

# Voice credit guardrails (AssemblyAI session time). 0 = no daily budget.
VOICE_MAX_SESSION_SECONDS=600
VOICE_MAX_CONCURRENT=4
VOICE_DAILY_BUDGET_SECONDS=0

# Per-IP / per-session request limits (sessions, turns, transactions, demo controls).
MIRROR_RATE_LIMIT=true

# Free-form typed commands the deterministic compiler cannot classify go to AssemblyAI's LLM
# Gateway (same API key). The model only proposes; every value is still checked against the
# user's words. Use a model your account has access to.
LLM_GATEWAY_ENABLED=true
LLM_GATEWAY_MODEL=qwen3.5-4b-32k-fast

# Allowed browser origins for the API when the UI is served from a different origin (Vite dev server).
MIRROR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
